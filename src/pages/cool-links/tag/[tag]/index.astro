---
import CoolLinksArchiveLayout from "@layouts/CoolLinksArchiveLayout.astro";
import { getAllTags, getPaginatedCoolLinks, getTagFilters, getDateFilters } from "@data/coolLinks";
import { buildCacheKey } from "@utils/cacheKey";

export async function getStaticPaths() {
  const tags = await getAllTags();
  const dateFilters = await getDateFilters();

  return Promise.all(
    tags.map(async (tag) => ({
      params: { tag: tag.slug },
      cacheKey: buildCacheKey(
        1,
        await getPaginatedCoolLinks(1, tag.slug),
        await getTagFilters(tag.slug),
        dateFilters,
        tags
      ),
    }))
  );
}

const { tag } = Astro.params;
const { links, currentPage, totalPages, totalLinks } = await getPaginatedCoolLinks(1, tag);

const allTags = await getAllTags();
const currentTag = allTags.find((t) => t.slug === tag);
const [tagFilters, dateFilters] = await Promise.all([
  getTagFilters(tag),
  getDateFilters(),
]);
---

<CoolLinksArchiveLayout
  links={links}
  currentPage={currentPage}
  totalPages={totalPages}
  totalLinks={totalLinks}
  currentTag={currentTag}
  tagFilters={tagFilters}
  dateFilters={dateFilters}
/>
