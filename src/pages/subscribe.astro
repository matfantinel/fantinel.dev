---
import GenericHero from '@components/organisms/GenericHero';
import SubscribeCta from '@components/organisms/SubscribeCta';
import BaseLayout from '@layouts/BaseLayout.astro';
import { getSubscribeConfig, getSiteMeta } from '@data/yaml';

const pageData = getSubscribeConfig();
const siteMeta = getSiteMeta();
const subscribeCta = {
  heading: pageData.subscribeCta?.heading || siteMeta.subscribeCta.heading,
  body: pageData.subscribeCta?.body || siteMeta.subscribeCta.body,
  items: pageData.subscribeCta?.items?.length ? pageData.subscribeCta.items : siteMeta.subscribeCta.items,
};
---

<BaseLayout
  title={pageData.pageTitle}
  description={pageData.pageDescription}
  image={pageData.pagePreviewImage ? siteMeta.baseUrl + pageData.pagePreviewImage : undefined}
>
  <div class="p-subscribe full-width u-content-grid">

    <div class="p-subscribe__hero full-width">
      <GenericHero
        title={pageData.hero?.title}
        body={pageData.hero?.body}
        image={pageData.hero?.image}
        hasTownSquare={pageData.hero?.hasTownSquare}
        client:load
      />
    </div>

    <div class="p-subscribe__cta">
      <SubscribeCta
        heading={subscribeCta.heading}
        body={subscribeCta.body}
        baseUrl={siteMeta.baseUrl}
        items={subscribeCta.items}
        client:visible
      />
    </div>
  </div>
</BaseLayout>

<style lang="scss">
  @use '/src/styles/mixins';

  .p-subscribe {
    &__cta {
      margin-top: var(--spacing-lg);
    }
  }
</style>
