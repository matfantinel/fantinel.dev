---
import BlogArchiveLayout from "@layouts/BlogArchiveLayout.astro";
import { getAllCategories, getCategoryFilters, getDateFilters, getPaginatedBlogPosts } from "@data/blogPosts";
import { buildCacheKey } from "@utils/cacheKey";

export async function getStaticPaths() {
  const categories = await getAllCategories();
  const dateFilters = await getDateFilters();

  return Promise.all(
    categories.map(async (category) => ({
      params: { category: category.slug },
      cacheKey: buildCacheKey(
        1,
        await getPaginatedBlogPosts(1, category.slug),
        await getCategoryFilters(category.slug),
        dateFilters,
        categories
      ),
    }))
  );
}

const { category } = Astro.params;
const { posts, currentPage, totalPages, totalPosts } = await getPaginatedBlogPosts(1, category);

const allCategories = await getAllCategories();
const categoryFilters = await getCategoryFilters(category);
const dateFilters = await getDateFilters();
const currentCategory = allCategories.find((c) => c.slug === category);
---

<BlogArchiveLayout
  posts={posts}
  currentPage={currentPage}
  totalPages={totalPages}
  totalPosts={totalPosts}
  currentCategory={currentCategory}
  categoryFilters={categoryFilters}
  dateFilters={dateFilters}
/>
