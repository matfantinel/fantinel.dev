---
import { getPaginatedReviews, getTypeFilters, getRatingFilters, getYearFilters } from '@data/quickReviews';
import QuickReviewsArchiveLayout from '@layouts/QuickReviewsArchiveLayout.astro';
import { QuickReviewRating } from '@schemas/quick-review-types';
import { buildCacheKey } from '@utils/cacheKey';

const { rating, page } = Astro.params;
const { reviews, currentPage, totalPages, totalReviews } = await getPaginatedReviews(Number(page), rating as QuickReviewRating);

const activeRating = Object.keys(QuickReviewRating).find((v) => v.toLowerCase() === rating?.toLowerCase());
const [typeFilters, ratingFilters, yearFilters] = await Promise.all([
  getTypeFilters(),
  getRatingFilters(activeRating),
  getYearFilters(),
]);

export async function getStaticPaths() {
  const ratings = Object.keys(QuickReviewRating).map((key) => key);
  const [typeFilters, yearFilters] = await Promise.all([getTypeFilters(), getYearFilters()]);

  const paths = await Promise.all(
    ratings.map(async (rating) => {
      const ratingFilters = await getRatingFilters(rating);
      const { totalPages, totalReviews } = await getPaginatedReviews(1, rating as QuickReviewRating);
      return Promise.all(
        Array.from({ length: totalPages }).map(async (_, i) => ({
          params: { rating: rating.toLowerCase(), page: String(i + 2) }, // start at page 2
          cacheKey: buildCacheKey(
            1,
            await getPaginatedReviews(i + 2, rating as QuickReviewRating),
            typeFilters,
            ratingFilters,
            yearFilters
          ),
        }))
      );
    })
  );

  return paths.flat();
}
---

<QuickReviewsArchiveLayout
  reviews={reviews}
  currentPage={currentPage}
  totalPages={totalPages}
  totalReviews={totalReviews}
  currentRating={rating as QuickReviewRating}
  typeFilters={typeFilters}
  ratingFilters={ratingFilters}
  yearFilters={yearFilters}
/>