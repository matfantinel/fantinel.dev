---
import { getPaginatedReviews, getTypeFilters, getRatingFilters, getYearFilters } from '@data/quickReviews';
import QuickReviewsArchiveLayout from '@layouts/QuickReviewsArchiveLayout.astro';
import { QuickReviewRating } from '@schemas/quick-review-types';
import { buildCacheKey } from '@utils/cacheKey';

const { rating } = Astro.params;
const { reviews, currentPage, totalPages, totalReviews } = await getPaginatedReviews(1, rating as QuickReviewRating);

const activeRating = Object.keys(QuickReviewRating).find((v) => v.toLowerCase() === rating?.toLowerCase());
const [typeFilters, ratingFilters, yearFilters] = await Promise.all([
  getTypeFilters(),
  getRatingFilters(activeRating),
  getYearFilters(),
]);

export async function getStaticPaths() {
  const [typeFilters, yearFilters] = await Promise.all([getTypeFilters(), getYearFilters()]);

  const paths = await Promise.all(
    Object.keys(QuickReviewRating).map(async (key) => ({
      params: { rating: key.toLowerCase() },
      cacheKey: buildCacheKey(
        1,
        await getPaginatedReviews(1, key as QuickReviewRating),
        typeFilters,
        await getRatingFilters(key),
        yearFilters
      ),
    }))
  );

  return paths;
}
---

<QuickReviewsArchiveLayout
  reviews={reviews}
  currentPage={currentPage}
  totalPages={totalPages}
  totalReviews={totalReviews}
  currentRating={rating as QuickReviewRating}
  typeFilters={typeFilters}
  ratingFilters={ratingFilters}
  yearFilters={yearFilters}
/>