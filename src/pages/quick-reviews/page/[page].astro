---
import QuickReviewsArchiveLayout from "@layouts/QuickReviewsArchiveLayout.astro";
import { getPaginatedReviews, getTypeFilters, getRatingFilters, getYearFilters } from "@data/quickReviews";
import { buildCacheKey } from "@utils/cacheKey";

export async function getStaticPaths() {
  const { totalPages, totalReviews } = await getPaginatedReviews(1); // Just to get count
  const [typeFilters, ratingFilters, yearFilters] = await Promise.all([
    getTypeFilters(),
    getRatingFilters(),
    getYearFilters(),
  ]);

  return Promise.all(
    Array.from({ length: totalPages }).map(async (_, i) => ({
      params: { page: String(i + 2) }, // start at page 2
      cacheKey: buildCacheKey(1, await getPaginatedReviews(i + 2), typeFilters, ratingFilters, yearFilters),
    }))
  );
}

const { page } = Astro.params;
const { reviews, currentPage, totalPages, totalReviews } = await getPaginatedReviews(Number(page));

const [typeFilters, ratingFilters, yearFilters] = await Promise.all([
  getTypeFilters(),
  getRatingFilters(),
  getYearFilters(),
]);
---

<QuickReviewsArchiveLayout
  reviews={reviews}
  currentPage={currentPage}
  totalPages={totalPages}
  totalReviews={totalReviews}
  typeFilters={typeFilters}
  ratingFilters={ratingFilters}
  yearFilters={yearFilters}
/>
